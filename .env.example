# Cloud sync (Supabase)
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings → API
# 3. Copy the Project URL and the Publishable key below
#    (older dashboards call this the "anon public" key — either format works)
# 4. Run the SQL in ./supabase/schema.sql in the Supabase SQL editor
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# Backend API: OpenRouter for lecture note summarization (DeepSeek model)
# 1. Sign up at https://openrouter.ai
# 2. Create an API key in your dashboard
# 3. Paste it here (or set OPENROUTER_API_KEY in your hosting environment)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Backend API: Optional DeepSeek model override (default: deepseek/deepseek-v4-flash)
# OPENROUTER_MODEL_ID=deepseek/deepseek-v4-flash

# Backend API: Optional Gemini fallback (for text-only summarization route)
# GEMINI_API_KEY=your-gemini-api-key-here

# Backend API: Local whisper.cpp transcription server (optional)
# WHISPER_SERVER_URL=http://127.0.0.1:8080/inference
# WHISPER_TIMEOUT_MS=120000

# Backend API: Server port (default: 4000)
# PORT=4000
